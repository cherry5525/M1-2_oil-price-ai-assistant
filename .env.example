# 이 파일은 견본입니다. 복사해서 프로젝트 맨 위 폴더에 .env 파일을 만들고 실제 값을 채우세요.
# .env 는 .gitignore 로 제외되어 GitHub에 올라가지 않습니다. 실제 키를 이 파일에 적지 마세요.

# ---- AI (OpenAI 호환 API) ----
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini
# (선택) 호출당 출력 토큰 상한 / 응답 대기 제한(초). 생략하면 아래 값이 기본값입니다.
OPENAI_MAX_COMPLETION_TOKENS=4000
OPENAI_TIMEOUT_SECONDS=60

# ---- Firebase ----
# 로컬 개발: 서비스 계정 키 파일 경로 (backend 폴더 기준)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# 배포(Render): 키 파일의 "내용 전체"를 이 변수에 붙여 넣습니다. 이 변수가 있으면 파일 경로보다 우선합니다.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# ---- CORS ----
# 허용할 프론트엔드 주소 (쉼표로 구분, 끝에 / 없음). 개발 중에는 * 도 가능합니다.
ALLOWED_ORIGINS=http://localhost:5500

# ---- 프론트엔드 (Vercel 환경 변수) ----
# 프론트엔드가 호출할 백엔드 주소. Vercel 배포 시 빌드 명령이 이 값으로 config.js 를 생성합니다.
# 로컬에서는 frontend/config.js 에 직접 적혀 있으므로 이 줄은 필요 없습니다.
# API_BASE_URL=https://oil-price-ai-assistant.onrender.com
